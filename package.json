{
  "name": "gino-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "pnpm build:wasm && pnpm --filter @gino-os/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @gino-os/web typecheck",
    "test": "pnpm --filter @gino-os/web test",
    "build": "pnpm build:wasm && pnpm --filter @gino-os/web build",
    "check:web": "pnpm build:wasm && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @gino-os/web build",
    "check:rust": "bash scripts/check-rust.sh",
    "check": "pnpm check:rust && pnpm check:web && pnpm check:wasm && pnpm test:web:browser && pnpm check:parity",
    "build:wasm": "bash scripts/build-wasm.sh",
    "test:wasm:node": "node --test tests/wasm/node.test.mjs",
    "test:wasm:browser": "playwright test -c tests/wasm/playwright.config.mjs",
    "typecheck:wasm": "pnpm --filter @gino-os/web exec tsc -p ../../tests/wasm/tsconfig.json",
    "check:wasm": "pnpm build:wasm && pnpm typecheck:wasm && pnpm test:wasm:node && pnpm test:wasm:browser",
    "test:web:browser": "playwright test -c tests/web/playwright.config.mjs",
    "test:parity:node": "node tests/parity/node.mjs",
    "test:parity:browser": "playwright test -c tests/parity/playwright.config.mjs",
    "check:parity": "pnpm build:wasm && pnpm test:parity:node && pnpm test:parity:browser"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.2"
  }
}
