[
  {
    "name": "adapter-smoke",
    "smoke": true,
    "steps": [
      {
        "input": "help",
        "expected": {
          "status": 0,
          "events": [
            {
              "type": "stdout",
              "text": "Available commands:\n  clear — Request a clear screen\n  echo — Print arguments as literal text\n  exit — Close the virtual session\n  help — List commands or describe one command\n  pwd — Print the virtual working directory\n  whoami — Print the virtual user\n"
            }
          ],
          "error": null,
          "session": {
            "cwd": "/home/visitor",
            "lastStatus": 0,
            "exitStatus": null
          }
        }
      },
      {
        "input": "help echo",
        "expected": {
          "status": 0,
          "events": [
            {
              "type": "stdout",
              "text": "echo — Print arguments as literal text\nUsage: echo [--] [text ...]\n"
            }
          ],
          "error": null,
          "session": {
            "cwd": "/home/visitor",
            "lastStatus": 0,
            "exitStatus": null
          }
        }
      },
      {
        "input": "pwd",
        "expected": {
          "status": 0,
          "events": [
            {
              "type": "stdout",
              "text": "/home/visitor\n"
            }
          ],
          "error": null,
          "session": {
            "cwd": "/home/visitor",
            "lastStatus": 0,
            "exitStatus": null
          }
        }
      },
      {
        "input": "whoami",
        "expected": {
          "status": 0,
          "events": [
            {
              "type": "stdout",
              "text": "visitor\n"
            }
          ],
          "error": null,
          "session": {
            "cwd": "/home/visitor",
            "lastStatus": 0,
            "exitStatus": null
          }
        }
      },
      {
        "input": "echo \"hello 🦀\"",
        "expected": {
          "status": 0,
          "events": [
            {
              "type": "stdout",
              "text": "hello 🦀\n"
            }
          ],
          "error": null,
          "session": {
            "cwd": "/home/visitor",
            "lastStatus": 0,
            "exitStatus": null
          }
        }
      },
      {
        "input": "missing",
        "expected": {
          "status": 127,
          "events": [
            {
              "type": "stderr",
              "text": "gino: command not found: \\\"missing\\\"\n"
            }
          ],
          "error": {
            "kind": "unknownCommand",
            "message": "command not found: \"missing\"",
            "span": null
          },
          "session": {
            "cwd": "/home/visitor",
            "lastStatus": 127,
            "exitStatus": null
          }
        }
      },
      {
        "input": "echo é | whoami",
        "expected": {
          "status": 2,
          "events": [
            {
              "type": "stderr",
              "text": "gino: parse error at bytes 8..9: syntax \\\"|\\\" is not supported yet\n"
            }
          ],
          "error": {
            "kind": "syntax",
            "message": "parse error at bytes 8..9: syntax \"|\" is not supported yet",
            "span": [8, 9]
          },
          "session": {
            "cwd": "/home/visitor",
            "lastStatus": 2,
            "exitStatus": null
          }
        }
      },
      {
        "input": "echo recovered",
        "expected": {
          "status": 0,
          "events": [
            {
              "type": "stdout",
              "text": "recovered\n"
            }
          ],
          "error": null,
          "session": {
            "cwd": "/home/visitor",
            "lastStatus": 0,
            "exitStatus": null
          }
        }
      },
      {
        "input": "clear",
        "expected": {
          "status": 0,
          "events": [
            {
              "type": "clearScreen"
            }
          ],
          "error": null,
          "session": {
            "cwd": "/home/visitor",
            "lastStatus": 0,
            "exitStatus": null
          }
        }
      },
      {
        "input": "exit 7",
        "expected": {
          "status": 7,
          "events": [],
          "error": null,
          "session": {
            "cwd": "/home/visitor",
            "lastStatus": 7,
            "exitStatus": 7
          }
        }
      }
    ]
  },
  {
    "name": "quoting-and-literals",
    "steps": [
      {
        "input": "echo",
        "expected": {
          "status": 0,
          "events": [
            {
              "type": "stdout",
              "text": "\n"
            }
          ],
          "error": null,
          "session": {
            "cwd": "/home/visitor",
            "lastStatus": 0,
            "exitStatus": null
          }
        }
      },
      {
        "input": "echo 'two words' '' 🦀",
        "expected": {
          "status": 0,
          "events": [
            {
              "type": "stdout",
              "text": "two words  🦀\n"
            }
          ],
          "error": null,
          "session": {
            "cwd": "/home/visitor",
            "lastStatus": 0,
            "exitStatus": null
          }
        }
      },
