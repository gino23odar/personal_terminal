          ],
          "error": null,
          "session": {
            "cwd": "/home/visitor",
            "lastStatus": 0,
            "exitStatus": null
          }
        }
      },
      {
        "input": "echo \"$HOME\" ~ \"\\n\"",
        "expected": {
          "status": 0,
          "events": [
            {
              "type": "stdout",
              "text": "$HOME ~ \\n\n"
            }
          ],
          "error": null,
          "session": {
            "cwd": "/home/visitor",
            "lastStatus": 0,
            "exitStatus": null
          }
        }
      },
      {
        "input": "echo -- -n",
        "expected": {
          "status": 0,
          "events": [
            {
              "type": "stdout",
              "text": "-n\n"
            }
          ],
          "error": null,
          "session": {
            "cwd": "/home/visitor",
            "lastStatus": 0,
            "exitStatus": null
